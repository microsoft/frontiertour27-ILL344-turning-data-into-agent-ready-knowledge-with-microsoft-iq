# Foundry IQ (Azure AI Search) Configuration
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.services.ai.azure.com/
AZURE_OPENAI_KEY=your-openai-api-key
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_CHATGPT_MODEL_NAME=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Tenant and project configuration
AZURE_TENANT_ID=your-tenant-id
MICROSOFT_FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project-name

# Fabric IQ
FABRIC_WORKSPACE_ID=your-fabric-workspace-id
FABRIC_ONTOLOGY_ID=your-fabric-ontology-id
FABRIC_ONTOLOGY_MCP_URL=https://api.fabric.microsoft.com/v1/mcp/dataPlane/workspaces/your-fabric-workspace-id/items/your-fabric-ontology-id/ontologyEndpoint

# Work IQ (written by infra/create-workiq-entra.py)
WORK_IQ_ENTRA_APP_ID=your-work-iq-entra-app-id
WORK_IQ_ENTRA_TENANT_ID=your-tenant-id

# Web IQ (create an API key at https://webiq.microsoft.ai/profiles)
WEB_IQ_KEY=your-web-iq-api-key
